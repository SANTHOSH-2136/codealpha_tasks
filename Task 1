import random

WORDS = ["python", "hangman", "keyboard", "developer", "algorithm"]
MAX_WRONG_GUESSES = 6

HANGMAN_PICS = [
    """
       ------
       |    |
       |
       |
       |
       |
    --------
    """,
    """
       ------
       |    |
       |    O
       |
       |
       |
    --------
    """,
    """
       ------
       |    |
       |    O
       |    |
       |
       |
    --------
    """,
    """
       ------
       |    |
       |    O
       |   /|
       |
       |
    --------
    """,
    """
       ------
       |    |
       |    O
       |   /|\\
       |
       |
    --------
    """,
    """
       ------
       |    |
       |    O
       |   /|\\
       |   /
       |
    --------
    """,
    """
       ------
       |    |
       |    O
       |   /|\\
       |   / \\
       |
    --------
    """,
]


def choose_word():
    return random.choice(WORDS)


def display_state(word, guessed_letters, wrong_guesses):
    print(HANGMAN_PICS[wrong_guesses])
    displayed = ""
    for letter in word:
        if letter in guessed_letters:
            displayed += letter + " "
        else:
            displayed += "_ "
    print("Word: " + displayed)
    print("Wrong guesses left: " + str(MAX_WRONG_GUESSES - wrong_guesses))
    print("Guessed letters: " + ", ".join(sorted(guessed_letters)) if guessed_letters else "Guessed letters: none")
    print()


def get_guess(guessed_letters):
    while True:
        guess = input("Guess a letter: ").lower().strip()

        if len(guess) != 1:
            print("Please enter exactly one letter.\n")
            continue
        if not guess.isalpha():
            print("Please enter a valid letter (a-z).\n")
            continue
        if guess in guessed_letters:
            print("You already guessed that letter. Try again.\n")
            continue

        return guess


def play_game():
    word = choose_word()
    guessed_letters = set()
    wrong_guesses = 0

    print("=" * 40)
    print("Welcome to Hangman!")
    print("=" * 40)
    print("Try to guess the word, one letter at a time.")
    print("You have " + str(MAX_WRONG_GUESSES) + " incorrect guesses allowed.\n")

    while wrong_guesses < MAX_WRONG_GUESSES:
        display_state(word, guessed_letters, wrong_guesses)

        # Check win condition
        if all(letter in guessed_letters for letter in word):
            print("Congratulations! You guessed the word: " + word)
            break

        guess = get_guess(guessed_letters)
        guessed_letters.add(guess)

        if guess in word:
            print("Good guess!\n")
        else:
            wrong_guesses += 1
            print("Sorry, '" + guess + "' is not in the word.\n")
    else:
        # Loop ended because wrong_guesses reached the max (player lost)
        print(HANGMAN_PICS[wrong_guesses])
        print("You've been hanged! Game over.")
        print("The word was: " + word)


def main():
    play_again = "y"
    while play_again == "y":
        play_game()
        play_again = input("\nPlay again? (y/n): ").lower().strip()

    print("\nThanks for playing Hangman! Goodbye.")


if __name__ == "__main__":
    main()
